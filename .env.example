# Supabase — get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for admin operations (NEVER expose to the browser).
# Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth redirects + Stripe return). In prod set to your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (OPTIONAL — premium card payments). Leave empty to disable card
# checkout; the manual "request access" flow still works without it.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Create a webhook endpoint at https://YOUR_DOMAIN/api/stripe/webhook,
# listen for `checkout.session.completed`, then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=
